@Article{SLR_science_outreach_research_quality,
  author           = {Cristina Guarrella and Julia L. Hill and Victoria Millar and Maurizio Toscano and Jan van Driel and Deya Chakraborty},
  journal          = {Studies in Science Education},
  title            = {A systematic review of science outreach: characteristics and research quality},
  year             = {2025},
  number           = {0},
  pages            = {1--31},
  volume           = {0},
  comment-2578074o = {Science outreach SLR - exluding engineering in the search unfortunately but still had good points to consider
Reasons for science outreach - securing a diverse highly skilled workforce, maintaining public trust in science
50% of active scientists participate in some form of science outreach
Aims of science outreach - attract people into careers, foster scientific literacy, increase participation from underrepresented groups
Studies have been published since 90s
Limits - fragmented research across disciplines and journals with disparate audiences 
THEY PROVIDE STEM OUTREACH DEFINITION (OR MORE LIKE SCIENCE OUTREACH) 
other sources definitions - learning outside of typical teacher-student interactions AND MOREEEE
summary of aims of science outreach programmes, and overarching aims
source of bias - the universities that are both conducting and researching the outreach programmes - pre-register hypothesis about anticipated impacts along with detailed science outreach program designs before conducting outtreach activities and associated research
Are there clear research questions and Do the collected data allow to answer the research questions?
Many times the science outreach papers are just evaluative studies provided a detailed description of an outreach programme - many times the studies loked for enjoyment but not address a specific RQ
ASPIRE suggests that social and cultural factors may be more influential than specific pedagogical approaches in shapin gsustained science identities
issues with situational interest - temporary engagement that does not necessarily translate into enduring personal interest or motivation in science

A NEED FOR MORE INTENTIONAL ALIGNMENT BETWEEN INTENDED OUTCOMES AND THE DESIGN OF SCIENCE OUTREACH

overwhelming positive bias raises concerns about objectivity of research when the researchers are also the science outreach program providers
lack of clarity between program aims and research objectives 
there is still larger importance of early STEM experiences in shaping long-term engagement and career aspirations - concerning that most people focus on secondary school pupils when they are supposed to choose their subject
"era when science misinformation proliferates and public trust in science fluctuates Osborne and Pimentel 2023},
  doi              = {10.1080/03057267.2025.2576976},
  eprint           = {https://doi.org/10.1080/03057267.2025.2576976},
  file             = {:C\:/Users/2578074O/OneDrive - University of Glasgow/Documents/2 Project - Rectifier_Tool_Paper/References/A systematic review of science outreach  characteristics and research quality.pdf:PDF},
  groups           = {Stats and Educational Frameworks},
  publisher        = {Routledge},
  url              = {https://doi.org/10.1080/03057267.2025.2576976},
}

