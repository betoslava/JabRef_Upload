@Article{constructivist_theory,
  author           = {Bada, Steve Olusegun},
  journal          = {IOSR Journal of Research \& Method in Education (IOSR-JRME)},
  title            = {Constructivism Learning Theory: A Paradigm for Teaching and Learning},
  year             = {2015},
  issn             = {2320-7388},
  month            = {Nov--Dec},
  number           = {6},
  pages            = {66--70},
  volume           = {5},
  comment-2578074o = {The restriction of education is that teachers cannot simply transmit knowledge to students but students need to actively construct knowledge in their own minds. 
Constructivism is an approach to teaching and learning based on the premise that cognition (learning) is the results of "mental construction"
Constructivist believe that learning is affected by the context in which an idea is taught as well as by students' beliefs and attitudes.
People construct their own understanding and knowledge of the world, through experiencing things and reflecting on these experiences (Bereiter, 1994). To achieve this, we must ask questions, explore and assess what we know. IN THE CLASSROOM, THE CONSTRUCTIVIST VIEW LEARNING CAN POINT TOWARDS A NUMBER OF DIFFERENT TEACHING PRACTICES. IN THE MOST GENERAL SENSE, IT USUALLY MEANS ENCOUARING STUDENTS TO USE ACTIVE TECHNIQUES (EXPERIMENTS, REAL-WORLD PROBLEM SOLVING (OLIVER, 2000)
Constructivism learning theory argues that people produce knowledge and form meaning based upon their experiences.
Then this paper lists the basic characteristics and pedagogical goals of CLT
IMplications of constructivism for teaching and learning (picked relevant points):
- encourage and accept student autonomy
- use a wide variety of materials, including raw data, primary sources, and interactive materials and encourage to use them
- inquire about students' understanding of concept before sharing your own understanding of those concepts
- assess students' understanding through application and performance of open-structured tasks

"students centred learning"},
  doi              = {10.9790/7388-05616670},
  file             = {:C\:/Users/2578074O/OneDrive - University of Glasgow/Documents/2 Project - Rectifier_Tool_Paper/References/Learning Theory/constructivism.pdf:PDF},
  groups           = {Stats and Educational Frameworks},
  readstatus       = {read},
}

